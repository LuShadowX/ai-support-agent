# --- LLM (any OpenAI-compatible API) ---
# OpenRouter (default): https://openrouter.ai/keys
LLM_API_KEY=sk-or-...
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=google/gemini-2.5-flash
# Gemini direct instead:
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-2.5-flash

# --- Branding ---
BUSINESS_NAME=Nimbus Home
BOT_NAME=Nimbus Assistant

# --- Security ---
# JSON list of sites allowed to embed the widget, e.g. ["https://client-site.com"]
ALLOWED_ORIGINS=["*"]
RATE_LIMIT_PER_MINUTE=20
# Set to enable GET /api/tickets (send header: X-Admin-Token)
ADMIN_TOKEN=

# --- Telegram (optional) ---
TELEGRAM_BOT_TOKEN=
